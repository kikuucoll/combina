rules_version = '2';
// Regles de seguretat de Firestore per a «combina ≈»
service cloud.firestore {
  match /databases/{database}/documents {

    function signedAs(uid) { return request.auth != null && request.auth.uid == uid; }
    function validName(d) {
      // Àlies: sense @, sense 4 o més xifres seguides (telèfons, anys) i sense adreces web
      return !('name' in d) || (d.name is string && d.name.size() >= 1 && d.name.size() <= 24
        && !d.name.matches('.*@.*')
        && !d.name.matches('.*[0-9]{4,}.*')
        && !d.name.lower().matches('.*(www|http|[.](com|cat|es|net|org)).*'));
    }
    function validAvatar(d) {
      return !('avatar' in d) || (d.avatar is string && d.avatar.size() <= 12);
    }
    function lvl(x) { return x is int && x >= 0 && x <= 100; }

    // Puntuació d'un jugador en un dia: tothom la pot llegir.
    // Anti-trampes: només el mateix jugador, una sola vegada, amb 5 nivells de 0 a 100 punts,
    // el total ha de ser exactament la suma dels nivells i la data la posa el servidor.
    match /days/{day}/scores/{uid} {
      allow read: if true;
      allow create: if signedAs(uid)
        && day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'photo', 'total', 'exact', 'levels', 'exprs', 'at'])
        && request.resource.data.levels is list
        && request.resource.data.levels.size() == 5
        && lvl(request.resource.data.levels[0]) && lvl(request.resource.data.levels[1])
        && lvl(request.resource.data.levels[2]) && lvl(request.resource.data.levels[3])
        && lvl(request.resource.data.levels[4])
        && request.resource.data.total is int
        && request.resource.data.total == request.resource.data.levels[0] + request.resource.data.levels[1]
             + request.resource.data.levels[2] + request.resource.data.levels[3] + request.resource.data.levels[4]
        && request.resource.data.exact is int
        && request.resource.data.exact >= 0 && request.resource.data.exact <= 5
        && (!('exprs' in request.resource.data) || (request.resource.data.exprs is list && request.resource.data.exprs.size() <= 5))
        && request.resource.data.at == request.time
        && validName(request.resource.data)
        && validAvatar(request.resource.data);
      // Després només se'n pot canviar el nom i l'avatar (mai els punts), i esborrar les operacions antigues
      allow update: if signedAs(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'photo', 'exprs'])
        && !('exprs' in request.resource.data)
        && validName(request.resource.data)
        && validAvatar(request.resource.data);
      // Dret de supressió: el mateix jugador, només quan el seu perfil desapareix en la mateixa operació
      // (o ja no hi és). Així no es pot esborrar una puntuació per tornar a jugar el dia.
      allow delete: if signedAs(uid)
        && !existsAfter(/databases/$(database)/documents/players/$(uid));
    }

    // Perfil públic i acumulat del jugador (rànquing total).
    // Anti-trampes: el total acumulat només pot créixer exactament amb la puntuació d'un dia
    // nou que s'escriu en la mateixa operació.
    match /players/{uid} {
      function newScore() {
        return getAfter(/databases/$(database)/documents/days/$(request.resource.data.last)/scores/$(uid)).data;
      }
      function isNewDay() {
        return request.resource.data.last is string
          && !exists(/databases/$(database)/documents/days/$(request.resource.data.last)/scores/$(uid))
          && existsAfter(/databases/$(database)/documents/days/$(request.resource.data.last)/scores/$(uid));
      }
      function profileOnly(keys) { return keys.hasOnly(['name', 'avatar', 'updatedAt']); }

      allow read: if true;

      allow create: if signedAs(uid)
        && validName(request.resource.data) && validAvatar(request.resource.data)
        && (profileOnly(request.resource.data.keys())
            || (isNewDay()
                && request.resource.data.sum == newScore().total
                && request.resource.data.days == 1
                && request.resource.data.best == newScore().total));

      allow update: if signedAs(uid)
        && validName(request.resource.data) && validAvatar(request.resource.data)
        && (profileOnly(request.resource.data.diff(resource.data).affectedKeys())
            || (isNewDay()
                && request.resource.data.last != resource.data.get('last', '')
                && request.resource.data.sum == resource.data.get('sum', 0) + newScore().total
                && request.resource.data.days == resource.data.get('days', 0) + 1
                && request.resource.data.best >= resource.data.get('best', 0)
                && request.resource.data.best >= newScore().total
                && (request.resource.data.best == resource.data.get('best', 0)
                    || request.resource.data.best == newScore().total)));

      // Dret de supressió: només el mateix jugador
      allow delete: if signedAs(uid);
    }

    // Recompte anònim del dia: { s: persones que l'han començat, n: persones que l'han acabat,
    // sum: suma dels seus punts }. Sense cap identificador. Cada escriptura és, o bé +1 a s (algú
    // comença), o bé +1 a n i de 0 a 500 punts a sum (algú acaba). Res més.
    match /stats/{day} {
      function nd() { return request.resource.data; }
      function startOnly() { return nd().keys().hasOnly(['s']) && nd().s == 1; }
      function finishOnly() {
        return nd().keys().hasOnly(['n', 'sum']) && nd().n == 1
          && nd().sum is int && nd().sum >= 0 && nd().sum <= 500;
      }
      allow read: if true;
      allow create: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$') && (startOnly() || finishOnly());
      allow update: if nd().keys().hasOnly(['n', 'sum', 's'])
        && ((nd().diff(resource.data).affectedKeys().hasOnly(['s'])
             && nd().s == resource.data.get('s', 0) + 1)
         || (nd().diff(resource.data).affectedKeys().hasOnly(['n', 'sum'])
             && nd().n == resource.data.get('n', 0) + 1
             && nd().sum is int
             && nd().sum >= resource.data.get('sum', 0)
             && nd().sum <= resource.data.get('sum', 0) + 500));
    }

    // Progrés privat (ratxa, segells, dies jugats): només el propi jugador
    match /saves/{uid} {
      allow read: if signedAs(uid);
      allow create, update: if signedAs(uid)
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow delete: if signedAs(uid);
    }
  }
}
